{
  "name": "jonhassall/laravel-scout-batcher",
  "description": "Database-backed batching and debouncing for Laravel Scout indexing operations.",
  "keywords": [
    "laravel",
    "scout",
    "search",
    "batch",
    "debounce",
    "meilisearch",
    "algolia",
    "typesense"
  ],
  "license": "MIT",
  "type": "library",
  "homepage": "https://github.com/jonhassall/laravel-scout-batcher",
  "repository": {
    "type": "git",
    "url": "https://github.com/jonhassall/laravel-scout-batcher.git"
  },
  "require": {
    "illuminate/console": "^10.0|^11.0|^12.0|^13.0",
    "illuminate/database": "^10.0|^11.0|^12.0|^13.0",
    "illuminate/support": "^10.0|^11.0|^12.0|^13.0",
    "laravel/scout": "^10.0|^11.0",
    "php": "^8.1",
    "ramsey/uuid": "^4.7"
  },
  "require-dev": {
    "orchestra/testbench": "^8.0|^9.0|^10.0|^11.0",
    "phpunit/phpunit": "^10.5|^11.0"
  },
  "autoload": {
    "psr-4": {
      "LaravelScoutDebouncer\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "LaravelScoutDebouncer\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "LaravelScoutDebouncer\\ScoutDebouncerServiceProvider"
      ]
    }
  },
  "scripts": {
    "test": "phpunit",
    "lint": "find src config database tests -name '*.php' -print0 | xargs -0 -n1 php -l"
  },
  "config": {
    "sort-packages": true
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
